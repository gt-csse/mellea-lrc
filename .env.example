# Runtime configuration. Copy this file to .env and fill in private credentials.
# Required settings have no code fallback. Blank optional settings mean no override.

# CourtListener: supply your proxy URL; the ordinary client uses the proxy's own keys.
COURTLISTENER_BASE_URL=
COURTLISTENER_TIMEOUT_SECONDS=45
# Required only when explicitly selecting the reserved pool.
COURTLISTENER_API_TOKEN_RESERVED=

# GovInfo: replace the public demo credential with your own key for normal use.
GOVINFO_BASE_URL=https://api.govinfo.gov/
GOVINFO_API_KEY=DEMO_KEY
GOVINFO_TIMEOUT_SECONDS=45

# Model packages and substage assignments. This .env is the configuration source.
# Required settings are explicit; blank optional settings use the provider default.
# Keep credentials in .env only. This example contains no secrets.
MELLEA_LRC_OPENROUTER_API_KEY=
MELLEA_LRC_NRP_API_KEY=

# openrouter_luna
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_MODEL=openai/gpt-6-luna
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_API_BASE=https://openrouter.ai/api/v1
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_API_KEY_ENV=MELLEA_LRC_OPENROUTER_API_KEY
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_TEMPERATURE=0
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_TIMEOUT_SECONDS=300
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_MAX_TOKENS=8000
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_MAX_ATTEMPTS=3
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_OUTPUT_MODE=json_schema
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_REASONING_EFFORT=low
MELLEA_LRC_PROFILE_OPENROUTER_LUNA_SERVICE_TIER=

# nrp_glm
MELLEA_LRC_PROFILE_NRP_GLM_MODEL=glm-5
MELLEA_LRC_PROFILE_NRP_GLM_API_BASE=https://ellm.nrp-nautilus.io/v1
MELLEA_LRC_PROFILE_NRP_GLM_API_KEY_ENV=MELLEA_LRC_NRP_API_KEY
MELLEA_LRC_PROFILE_NRP_GLM_TEMPERATURE=0
MELLEA_LRC_PROFILE_NRP_GLM_TIMEOUT_SECONDS=300
MELLEA_LRC_PROFILE_NRP_GLM_MAX_TOKENS=8000
MELLEA_LRC_PROFILE_NRP_GLM_MAX_ATTEMPTS=3
MELLEA_LRC_PROFILE_NRP_GLM_OUTPUT_MODE=json_schema
MELLEA_LRC_PROFILE_NRP_GLM_REASONING_EFFORT=low
MELLEA_LRC_PROFILE_NRP_GLM_SERVICE_TIER=

# nrp_qwen
MELLEA_LRC_PROFILE_NRP_QWEN_MODEL=qwen3
MELLEA_LRC_PROFILE_NRP_QWEN_API_BASE=https://ellm.nrp-nautilus.io/v1
MELLEA_LRC_PROFILE_NRP_QWEN_API_KEY_ENV=MELLEA_LRC_NRP_API_KEY
MELLEA_LRC_PROFILE_NRP_QWEN_TEMPERATURE=0
MELLEA_LRC_PROFILE_NRP_QWEN_TIMEOUT_SECONDS=300
MELLEA_LRC_PROFILE_NRP_QWEN_MAX_TOKENS=8000
MELLEA_LRC_PROFILE_NRP_QWEN_MAX_ATTEMPTS=3
MELLEA_LRC_PROFILE_NRP_QWEN_OUTPUT_MODE=json_schema
MELLEA_LRC_PROFILE_NRP_QWEN_REASONING_EFFORT=low
MELLEA_LRC_PROFILE_NRP_QWEN_SERVICE_TIER=

# nrp_kimi
MELLEA_LRC_PROFILE_NRP_KIMI_MODEL=kimi
MELLEA_LRC_PROFILE_NRP_KIMI_API_BASE=https://ellm.nrp-nautilus.io/v1
MELLEA_LRC_PROFILE_NRP_KIMI_API_KEY_ENV=MELLEA_LRC_NRP_API_KEY
MELLEA_LRC_PROFILE_NRP_KIMI_TEMPERATURE=0
MELLEA_LRC_PROFILE_NRP_KIMI_TIMEOUT_SECONDS=300
MELLEA_LRC_PROFILE_NRP_KIMI_MAX_TOKENS=8000
MELLEA_LRC_PROFILE_NRP_KIMI_MAX_ATTEMPTS=3
MELLEA_LRC_PROFILE_NRP_KIMI_OUTPUT_MODE=json_schema
MELLEA_LRC_PROFILE_NRP_KIMI_REASONING_EFFORT=low
MELLEA_LRC_PROFILE_NRP_KIMI_SERVICE_TIER=

# Each model-backed substage chooses one complete package.
MELLEA_LRC_SUBSTAGE_GROW_LEAVES_ID_CITATIONS_ATTRIBUTION_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_GROW_LEAVES_LEAF_FIELD_CORRECTION_REVIEW_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_GROW_LEAVES_REFERENCE_CITATIONS_ATTRIBUTION_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_GROW_LEAVES_SHORT_REPORTER_CITATIONS_ATTRIBUTION_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_GROW_LEAVES_SUPRA_CITATIONS_LLM_ATTRIBUTION_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_GROW_ROOTS_LOCATOR_DISCOVERY_DOCKET_HUNTING_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_GROW_ROOTS_ROOT_FORMATION_DOCKET_LLM_REASSIGNMENT_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_PINCITE_CITATION_PREPARATION_OPINION_REVIEW_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_PINCITE_CITATION_PREPARATION_PROPOSITIONS_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_PINCITE_SUPPORT_REVIEW_FULL_OPINION_REVIEW_PROFILE=nrp_qwen
MELLEA_LRC_SUBSTAGE_VALIDATE_PINCITE_SUPPORT_REVIEW_PAGE_REVIEW_PROFILE=nrp_glm
MELLEA_LRC_SUBSTAGE_VALIDATE_ROOTS_DOCKET_LOOKUP_COURTLISTENER_REVIEW_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_ROOTS_DOCKET_LOOKUP_GOVINFO_REVIEW_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_ROOTS_INTENDED_CASE_DISCOVERY_LLM_SELECTION_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_ROOTS_LOCATOR_BODY_CORROBORATION_LLM_JUDGMENT_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_ROOTS_REPORTER_LOOKUP_AMBIGUOUS_LLM_JUDGMENT_PROFILE=openrouter_luna
MELLEA_LRC_SUBSTAGE_VALIDATE_ROOTS_REPORTER_LOOKUP_UNIQUE_LLM_JUDGMENT_PROFILE=openrouter_luna
